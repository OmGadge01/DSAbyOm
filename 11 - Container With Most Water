class Solution {
    public int maxArea(int[] height) {
       int n = height.length-1;
       int left = 0;
       int right = n;
       int maxarea = 0;
       while(left<right){
        int width = right - left;
        int curarea = Math.min(height[right] , height[left]) * width;
        maxarea = Math.max(curarea , maxarea);

        if(height[left]< height[right]){
            left++;
        }
        else{
            right--;
        }
       } 
       return maxarea;
    }
}
